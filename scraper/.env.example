# ==============================================================================
# Environment Configuration (.env)
# Rename this file to .env and fill in your credentials.
# Secrets are NEVER committed or hardcoded in python files.
# ==============================================================================

# ------------------------------------------------------------------------------
# REDDIT API CREDENTIALS (Layer 1)
# Create a script app at https://www.reddit.com/prefs/apps
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=python:automated_funny_scraper:v1.0 (by /u/YOUR_REDDIT_USERNAME)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ------------------------------------------------------------------------------
# X (TWITTER) OPTIONAL COOKIES & AUTH (Layer 1 / Layer 2)
# Export cookies.txt from your logged-in browser using a browser extension:
# "Get cookies.txt LOCALLY" (Chrome / Firefox) and place in scraper/cookies.txt
# ------------------------------------------------------------------------------
TWITTER_COOKIES_PATH=cookies.txt

# ------------------------------------------------------------------------------
# PROXY CONFIGURATION (Optional - for rate limit / IP block prevention)
# ------------------------------------------------------------------------------
# HTTP_PROXY=http://user:password@proxy.example.com:8080
# HTTPS_PROXY=http://user:password@proxy.example.com:8080

